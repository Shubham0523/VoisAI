# Offline profile: every LLM role on local Ollama. Used by tests/sim when no cloud keys.
# Usage: set -a; source backend/.env.local-llm; set +a
FRIEND_BASE_URL=http://localhost:11434/v1
FRIEND_API_KEY=ollama
FRIEND_MODEL=qwen3.5:9b
FRIEND_REASONING_EFFORT=none
ANALYST_BASE_URL=http://localhost:11434/v1
ANALYST_API_KEY=ollama
ANALYST_MODEL=qwen3.5:9b
SIM_BASE_URL=http://localhost:11434/v1
SIM_API_KEY=ollama
SIM_MODEL=qwen3.5:9b
SIM_REASONING_EFFORT=none
FRIEND_TIMEOUT_S=120
ANALYST_REASONING_EFFORT=none
