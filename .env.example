# Copy to .env and fill in. Every service below has a free tier; none needs a card.

# LiveKit Cloud (free Build plan): cloud.livekit.io -> project -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram ($200 free credit, covers STT + TTS): console.deepgram.com
DEEPGRAM_API_KEY=

# Friend LLM: Groq (free, very low latency): console.groq.com/keys
FRIEND_API_KEY=
# FRIEND_MODEL=openai/gpt-oss-120b

# Analyst/Planner LLM: Gemini (free tier, separate quota): aistudio.google.com/apikey
ANALYST_API_KEY=
# ANALYST_MODEL=gemini-3.5-flash-lite

# Simulated learners (eval harness). Defaults to Groq 8B; reuse the Groq key.
SIM_API_KEY=

# Local Postgres from docker-compose
DATABASE_URL=postgresql+asyncpg://voisai:voisai@localhost:5433/voisai
